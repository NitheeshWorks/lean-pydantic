import LeanPydantic.Proofs.Choice
import LeanPydantic.RepoImpl.Repr

/-!
# APIs: models, `TypeAdapter`, and pydantic's method names

`Model α` is what `deriving Model` produces for a structure: the model's
title, its fields as a lawful `Fields` value, and the two directions between
the structure and the product of its fields. From it come the `FromJson`,
`ToJson`, `JsonSchema` and `LawfulJson` instances, for every model at once.

The functions carry pydantic's names:

| pydantic | here |
|---|---|
| `Item.model_validate(obj, strict=)` | `Item.model_validate obj (strict := …)` |
| `Item.model_validate_json(data)` | `Item.model_validate_json data` |
| `item.model_dump(include=, exclude=, exclude_defaults=, exclude_none=)` | `item.model_dump (exclude := …)` |
| `item.model_dump_json(indent=)` | `item.model_dump_json (indent := 2)` |
| `item.model_fields_set` | `item.model_fields_set` (on a validated `item`) |
| `Item.model_json_schema()` | `Item.model_json_schema` |
| `TypeAdapter(int).validate_python(x)` | `(TypeAdapter.new Int).validate_python x` |
| `ValidationError.errors()`, `.json()` | `ValidationError.errors`, `.json` |
| `repr(item)`, `str(item)`, `print(item)` | `pyRepr item`, `toString item`, `IO.println item` |
| `str(e)`, `print(e)` for a `ValidationError` | `toString e`, `IO.println e` |

The `Item.*` names are generated by `deriving Model`; they are the
`Model.*` functions below at `α := Item`.
-/

namespace LeanPydantic

open LeanJson (Json Number Decimal)

/-- A model: what `deriving Model` builds from a structure. -/
class Model (α : Type) where
  /-- The product of the field types. -/
  {Product : Type}
  /-- The class name: the schema's `title`, `model_type`'s `class_name`. -/
  title : String
  fields : Fields Product
  into : α → Product
  back : Product → α
  back_into : ∀ a, back (into a) = a
  /-- `model_config['extra']`. -/
  extra : Extra := .ignore
  /-- Each field's name and the `repr` of its value, given the input it was
  validated from, in field order (pydantic's `__repr_args__`). -/
  reprArgs : Option Json → InputMode → α → List (String × String) := fun _ _ _ => []

/-- A model whose fields are lawful (every field type is). `deriving Model`
proves it when it can; a model with, say, a `Float` field has no such
instance, and keeps its validator and serialiser without the laws. The round
trip, the located errors and the `extra='forbid'` law need only this. -/
class LawfulFields (α : Type) [m : Model α] : Prop where
  lawful : m.fields.Lawful

/-- A model whose schema is also sound: lawful fields, and no field name its
validator accepts beside the schema's keys. `deriving Model` proves it unless
a field is read by its name (`populate_by_name` with an alias, or
`extra='forbid'` with an alias, from JSON text): pydantic's schema lists
only the alias there (UP-065). -/
class LawfulModel (α : Type) [m : Model α] : Prop extends LawfulFields α where
  /-- Every field is read by its key alone, and strictly decoded fields
  satisfy their schema. -/
  sound : m.fields.Sound
  /-- Under `extra='forbid'` no field has an alias other than its name
  (pydantic's JSON validation accepts and drops such a field's name, which
  its schema forbids, so such a model has no schema-soundness law). -/
  forbid_names : m.extra = .forbid → ∀ n ∈ m.fields.names, n ∈ m.fields.keys

namespace Model

variable {α : Type}

instance (priority := low) [m : Model α] : FromJson α :=
  ⟨m.title, Fields.validate m.title m.extra m.fields m.back, fun _ => true⟩
instance (priority := low) [m : Model α] : ToJson α := ⟨Fields.dump m.extra m.fields m.into⟩
instance (priority := low) [m : Model α] : JsonSchema α := ⟨Fields.schema m.title m.extra m.fields⟩

theorem fromJson_eq [m : Model α] (cfg : Cfg) (j : Json) :
    fromJson (α := α) cfg j = Fields.validate m.title m.extra m.fields m.back cfg j := rfl

theorem toJson_eq [m : Model α] (o : DumpOpts) (a : α) :
    toJson o a = Fields.dump m.extra m.fields m.into o a := rfl

/-- **Round trip**: validating a model's dump by alias gives it back, from
its fields' laws alone (whatever its `extra` and `populate_by_name`). -/
theorem fromJson_toJson [m : Model α] [hl : LawfulFields α] (cfg : Cfg) (a : α) :
    fromJson cfg (toJson DumpOpts.roundTrip a) = .ok a := by
  rw [fromJson_eq, toJson_eq, Fields.dump_roundTrip]
  exact Fields.validate_encode hl.lawful m.back_into cfg a

/-- **Every model is lawful**, from its fields' laws, whatever its `extra`
policy. -/
instance (priority := low) lawfulJson [m : Model α] [hl : LawfulModel α] : LawfulJson α where
  fromJson_toJson := fromJson_toJson
  schema_sound cfg j a hs h := by
    rw [fromJson_eq] at h
    exact Fields.validate_sound hl.lawful hl.sound hl.forbid_names cfg j a hs h
  errors_ne_nil cfg j := by
    rw [fromJson_eq]; exact Fields.validate_ne_nil hl.lawful cfg j

instance (priority := low) [Model α] : NonNull α := ⟨fun _ _ => nofun⟩

/-- `Item(name='x', price=1.0)`: pydantic's `__repr__`. -/
def reprWith (title : String) (args : List (String × String)) : String :=
  title ++ "(" ++ ", ".intercalate (args.map fun (k, v) => k ++ "=" ++ v) ++ ")"

/-- `name='x' price=1.0`: pydantic's `__str__`. -/
def strWith (args : List (String × String)) : String :=
  " ".intercalate (args.map fun (k, v) => k ++ "=" ++ v)

/-- The `repr` arguments of a model validated from `src`: its fields, then
(under `extra='allow'`) the input's extras. -/
def reprArgsIn [m : Model α] (src : Option Json) (mode : InputMode) (a : α) : List (String × String) :=
  m.reprArgs src mode a ++
    if m.extra = .allow then
      match src with
      | some (.obj ⟨kvs⟩) => (dedup (m.fields.extras mode kvs)).map fun (k, j) => (k, pyReprJson j)
      | _ => []
    else []

instance (priority := low) [m : Model α] : PyRepr α := ⟨fun src mode a => reprWith m.title (reprArgsIn src mode a)⟩
/-- `print(item)` shows `str(item)`. -/
instance (priority := low) [Model α] : ToString α := ⟨fun a => strWith (reprArgsIn none .python a)⟩

/-- **Errors are located**: every error of a model whose input is an object
is placed under one of its fields (by key, or by name for a field read by its
name under `populate_by_name`), or, under `extra='forbid'`, under one of the
input's own keys (an `extra_forbidden`). -/
theorem validate_loc_prefix [m : Model α] [hl : LawfulFields α] (cfg : Cfg) (kvs : List (String × Json))
    (es : List ErrorDetails) (h : fromJson (α := α) cfg (.obj ⟨kvs⟩) = .error es) :
    ∀ e ∈ es, ∃ k, (k ∈ m.fields.keys ∨ k ∈ m.fields.names ∨ (m.extra = .forbid ∧ k ∈ kvs.map Prod.fst)) ∧
      ∃ l, e.loc = .key k :: l := by
  rw [fromJson_eq] at h
  exact Fields.validate_loc hl.lawful cfg kvs es h

/-- **`extra='forbid'`**: a model validates an object exactly when it has no
extras (every member's key is one the fields accept: from Python objects,
those the fields read; from JSON text, every field's key and name) and every
field validates. It holds for every model, `populate_by_name` and aliases
included. -/
theorem validate_forbid_iff [m : Model α] (hx : m.extra = .forbid) (cfg : Cfg)
    (kvs : List (String × Json)) (a : α) :
    fromJson cfg (.obj ⟨kvs⟩) = .ok a ↔
      (∀ p ∈ kvs, p.1 ∈ m.fields.accepted cfg.mode kvs) ∧
        ∃ b, m.fields.decode cfg (.obj ⟨kvs⟩) kvs = .ok b ∧ m.back b = a := by
  rw [fromJson_eq, hx]
  exact Fields.validate_forbid_iff _ _ _ cfg kvs a

/-- **`extra='forbid'`, without `populate_by_name`**: the accepted keys no
longer depend on the input. A model validates an object exactly when every
member's key is a field's key (from JSON text, also a field's name) and
every field validates. -/
theorem validate_forbid_keys_iff [m : Model α] (hx : m.extra = .forbid) (hk : m.fields.ByKey) (cfg : Cfg)
    (kvs : List (String × Json)) (a : α) :
    fromJson cfg (.obj ⟨kvs⟩) = .ok a ↔
      (∀ p ∈ kvs, p.1 ∈ m.fields.acceptedNames cfg.mode) ∧
        ∃ b, m.fields.decode cfg (.obj ⟨kvs⟩) kvs = .ok b ∧ m.back b = a := by
  rw [fromJson_eq, hx]
  exact Fields.validate_forbid_keys_iff hk cfg kvs a

end Model

/-! ## Validation results -/

/-- What a successful validation guarantees: the value is the validator's
result for that input. (With the type's laws, the input then also conforms
to its schema in strict mode: `Validated.conforms`.) -/
structure Validated {α : Type} [FromJson α] (cfg : Cfg) (obj : Json) (a : α) : Prop where
  ref : fromJson cfg obj = .ok a

/-- A value validated from `obj`, with its guarantee. Like a pydantic model
instance it remembers its input, so its `model_dump (exclude_unset := true)`
leaves out what `obj` did not set (pydantic's `model_fields_set`). -/
structure Valid (α : Type) [FromJson α] (cfg : Cfg) (obj : Json) where
  val : α
  property : Validated cfg obj val

/-- A value validated from JSON text: the JSON value the text parses to, the
value validated from it, and the guarantees. -/
structure ValidJson (α : Type) [FromJson α] (strict : Bool) (data : String) where
  input : Json
  parsed : LeanJson.parseDocumentWith {} data.toUTF8 = .ok input
  val : α
  property : Validated { strict, mode := .json } input val

/-- The validated value, with the input it came from in its type. -/
def ValidJson.toValid {α : Type} [FromJson α] {strict : Bool} {data : String} (v : ValidJson α strict data) :
    Valid α { strict, mode := .json } v.input := ⟨v.val, v.property⟩

/-- `model_dump_json`'s `indent`: `(indent := 2)`, or none (pydantic's
`indent=None`, the default). -/
structure Indent where
  width : Option Nat := none

instance {n : Nat} : OfNat Indent n := ⟨⟨some n⟩⟩
instance : Coe Nat Indent := ⟨fun n => ⟨some n⟩⟩
instance : Coe (Option Nat) Indent := ⟨fun w => ⟨w⟩⟩

theorem Validated.conforms {α : Type} [FromJson α] [ToJson α] [JsonSchema α] [LawfulJson α]
    {cfg : Cfg} {obj : Json} {a : α} (h : Validated cfg obj a) (hs : cfg.strict = true) :
    Conforms (JsonSchema.schema α) obj :=
  LawfulJson.schema_sound cfg obj a hs h.ref

/-- The error reported if a validator ever failed without saying why (no
lawful validator does: `LawfulJson.errors_ne_nil`). -/
def unexplained (obj : Json) (mode : InputMode) : ErrorDetails :=
  { kind := .valueError "validation failed", input := obj, mode }

/-- Validate under a configuration: the value with its guarantee, or a
`ValidationError` (never empty). -/
def validateWith (α : Type) [FromJson α] (cfg : Cfg) (obj : Json) :
    Except ValidationError (Valid α cfg obj) :=
  match h : fromJson (α := α) cfg obj with
  | .ok a => .ok ⟨a, ⟨h⟩⟩
  | .error es =>
    if hn : es = [] then .error ⟨FromJson.title α, [unexplained obj cfg.mode], by simp⟩
    else .error ⟨FromJson.title α, es, hn⟩

/-- The `json_invalid` error pydantic reports for text that is not JSON. -/
def jsonInvalid (data : String) (e : LeanJson.JsonError) : ErrorDetails :=
  { kind := .jsonInvalid e.description, input := .str data, mode := .json }

/-- Parse JSON text and validate it in JSON mode: the value, a JSON value
the text parses to, and the guarantees for it. -/
def validateJsonWith (α : Type) [FromJson α] (strict : Bool)
    (data : String) : Except ValidationError (ValidJson α strict data) :=
  match LeanJson.from_json data with
  | .error e => .error ⟨FromJson.title α, [jsonInvalid data e], by simp⟩
  | .ok ⟨j, hj⟩ =>
    match validateWith α { strict, mode := .json } j with
    | .ok ⟨a, ha⟩ => .ok ⟨j, hj.ref, a, ha⟩
    | .error e => .error e

/-- The dump of `a` under pydantic's `model_dump` options. -/
def dumpWith {α : Type} [ToJson α] (a : α) («include» : Option (List String) := none)
    (exclude : List String := []) (by_alias : Bool := false) (exclude_unset : Bool := false)
    (exclude_defaults : Bool := false) (exclude_none : Bool := false) (set_from : Option Json := none) :
    Json :=
  toJson { «include», exclude, by_alias, exclude_unset, exclude_defaults, exclude_none, set_from } a

namespace Model

variable (α : Type) [m : Model α]

/-- `Model.model_validate(obj, strict=None, from_attributes=None)`. -/
def model_validate (obj : Json) (strict : Bool := false) (from_attributes : Bool := false) :
    Except ValidationError (Valid α { strict, from_attributes } obj) :=
  validateWith α { strict, from_attributes } obj

/-- `Model.model_validate_json(data, strict=None)`. -/
def model_validate_json (data : String) (strict : Bool := false) :=
  validateJsonWith α strict data

/-- `Model.model_json_schema()`. -/
def model_json_schema : Json := (JsonSchema.schema α).document

variable {α}

/-- `model.model_dump(include=, exclude=, by_alias=, exclude_unset=,
exclude_defaults=, exclude_none=)`. `set_from` is the input the model was
validated from, which `exclude_unset` consults. -/
def model_dump (a : α) («include» : Option (List String) := none) (exclude : List String := [])
    (by_alias : Bool := false) (exclude_unset : Bool := false) (exclude_defaults : Bool := false)
    (exclude_none : Bool := false) (set_from : Option Json := none) : Json :=
  dumpWith a «include» exclude by_alias exclude_unset exclude_defaults exclude_none set_from

/-- `model.model_dump_json(indent=None, ...)`. -/
def model_dump_json (a : α) (indent : Indent := {}) («include» : Option (List String) := none)
    (exclude : List String := []) (by_alias : Bool := false) (exclude_unset : Bool := false)
    (exclude_defaults : Bool := false) (exclude_none : Bool := false) (set_from : Option Json := none) :
    String :=
  LeanJson.printStr
    (dumpWith a «include» exclude by_alias exclude_unset exclude_defaults exclude_none set_from)
    { indent := indent.width }

/-! ## What is proved about them -/

/-- **Round trip** (`alias_roundtrip`): validating a model's dump by alias
gives the model back, strict or lax. -/
theorem model_validate_model_dump [LawfulFields α] (a : α) (strict : Bool := false) :
    (model_validate α (model_dump a (by_alias := true)) strict).map (·.val) = .ok a := by
  have h := Model.fromJson_toJson (α := α) { strict } a
  unfold model_validate validateWith
  split
  · rename_i b hb
    simp only [model_dump, dumpWith] at hb
    rw [show ({ by_alias := true } : DumpOpts) = DumpOpts.roundTrip from rfl, h] at hb
    cases hb; rfl
  · rename_i es hb
    simp only [model_dump, dumpWith] at hb
    rw [show ({ by_alias := true } : DumpOpts) = DumpOpts.roundTrip from rfl, h] at hb
    cases hb

/-- **Schema soundness**: what strict validation accepts conforms to
`model_json_schema`'s schema. -/
theorem schema_sound [LawfulModel α] {obj : Json} {a : α} (h : (model_validate α obj (strict := true)).map (·.val) = .ok a) :
    Conforms (JsonSchema.schema α) obj := by
  unfold model_validate validateWith at h
  split at h
  · rename_i b hb; exact LawfulJson.schema_sound _ obj b rfl hb
  · split at h <;> cases h

/-- **Dumps conform**: a model's dump by alias conforms to its schema. -/
theorem model_dump_conforms [LawfulModel α] (a : α) : Conforms (JsonSchema.schema α) (model_dump a (by_alias := true)) :=
  LawfulJson.schema_sound { strict := true } _ a rfl (LawfulJson.fromJson_toJson _ a)

/-- The fields of a value validated from `src` (in `mode`) that count as
set, as (name, key): their names are its `model_fields_set`. -/
def setFieldsOf (src : Option Json) (mode : InputMode) : List (String × String) :=
  m.fields.setFields src (m.fields.extraKeys m.extra src mode)

/-- The members a dump writes: the fields, then (under `allow`) the extras. -/
def dumpMembers (o : DumpOpts) (a : α) : List (String × Json) :=
  m.fields.encode { o with set_names := m.fields.extraKeys m.extra o.set_from o.set_mode } (m.into a) ++
    (if m.extra = .allow then m.fields.extraDump o else [])

theorem toJson_members (o : DumpOpts) (a : α) : toJson o a = .obj ⟨dumpMembers (α := α) o a⟩ := rfl

/-- A field counts as set exactly when its name is in `model_fields_set`. -/
theorem mem_fieldsSet_iff [hl : LawfulFields α] (src : Option Json) (mode : InputMode) {q : String × String}
    (hq : q ∈ m.fields.names.zip m.fields.keys) :
    q.1 ∈ m.fields.fieldsSet m.extra src mode ↔ q ∈ setFieldsOf (α := α) src mode :=
  Fields.mem_fieldsSet_iff hl.lawful m.extra src mode hq

/-- Under `exclude_unset` a dump writes only fields counted as set (under
their name, or by alias their key) and extras. -/
theorem dump_unset_subset [hl : LawfulFields α] (o : DumpOpts) (a : α) (hu : o.exclude_unset = true) :
    ∀ p ∈ dumpMembers (α := α) o a, (∃ q ∈ setFieldsOf (α := α) o.set_from o.set_mode, p.1 = Fields.dumpKey o.by_alias q) ∨
      p.1 ∈ m.fields.extraKeys m.extra o.set_from o.set_mode := fun p hp => by
  rcases List.mem_append.1 hp with hp | hp
  · exact Or.inl (hl.lawful.unset_subset { o with set_names := m.fields.extraKeys m.extra o.set_from o.set_mode }
      (m.into a) hu p hp)
  · split at hp
    · rename_i hx
      have := Fields.extraDump_key _ o p hp
      rw [← hx] at this
      exact Or.inr this
    · simp at hp

/-- With no other option leaving one out, an `exclude_unset` dump writes
every field counted as set. -/
theorem dump_unset_complete [hl : LawfulFields α] (o : DumpOpts) (a : α) (hu : o.exclude_unset = true)
    (hi : o.«include» = none) (he : o.exclude = []) (hn : o.exclude_none = false) (hd : o.exclude_defaults = false) :
    ∀ q ∈ setFieldsOf (α := α) o.set_from o.set_mode, ∃ p ∈ dumpMembers (α := α) o a, p.1 = Fields.dumpKey o.by_alias q :=
  fun q hq => by
    obtain ⟨p, hp, hpe⟩ := hl.lawful.unset_complete { o with set_names := m.fields.extraKeys m.extra o.set_from o.set_mode }
      (m.into a) hu hi he hn hd q hq
    exact ⟨p, List.mem_append_left _ hp, hpe⟩

/-- **`exclude_unset` dumps exactly what was set** (`exclude_unset_subset`):
a dump of a value validated from `j`, with `exclude_unset`, writes a field
only if its name is in `model_fields_set` (it was set by key, by name under
`populate_by_name`, or by an extra of that name), under its name or, by
alias, its key; every other member is an extra. -/
theorem exclude_unset_subset [LawfulFields α] (a : α) (j : Json) (by_alias : Bool := false)
    («include» : Option (List String) := none) (exclude : List String := [])
    (exclude_defaults exclude_none : Bool := false) :
    ∃ kvs, model_dump a «include» exclude by_alias (exclude_unset := true)
        exclude_defaults exclude_none (set_from := some j) = .obj ⟨kvs⟩ ∧
      ∀ p ∈ kvs, (∃ q ∈ setFieldsOf (α := α) (some j) .python, q.1 ∈ m.fields.fieldsSet m.extra (some j) .python ∧
          p.1 = Fields.dumpKey by_alias q) ∨ p.1 ∈ m.fields.extraKeys m.extra (some j) .python :=
  ⟨_, rfl, fun p hp => by
    rcases dump_unset_subset (α := α) _ a rfl p hp with ⟨q, hq, he⟩ | h
    · exact Or.inl ⟨q, hq, List.mem_append_left _ (List.mem_map_of_mem hq), he⟩
    · exact Or.inr h⟩

/-- **And every field whose name is in `model_fields_set` is written**, when
no other option leaves it out. -/
theorem exclude_unset_complete [LawfulFields α] (a : α) (j : Json) (by_alias : Bool := false)
    {q : String × String} (hq : q ∈ m.fields.names.zip m.fields.keys)
    (hs : q.1 ∈ m.fields.fieldsSet m.extra (some j) .python) :
    ∃ kvs, model_dump a (by_alias := by_alias) (exclude_unset := true) (set_from := some j) = .obj ⟨kvs⟩ ∧
      ∃ p ∈ kvs, p.1 = Fields.dumpKey by_alias q :=
  ⟨_, rfl, dump_unset_complete (α := α) _ a rfl rfl rfl rfl rfl q ((mem_fieldsSet_iff (α := α) _ _ hq).1 hs)⟩

end Model

/-! ## Validated models remember their input -/

namespace Valid

variable {α : Type} [m : Model α] {cfg : Cfg} {obj : Json}

/-- The dump options of a validated value: its input, and the input's mode. -/
def validOpts («include» : Option (List String)) (exclude : List String) (by_alias exclude_unset
    exclude_defaults exclude_none : Bool) (obj : Json) (mode : InputMode) : DumpOpts where
  «include» := «include»
  exclude := exclude
  by_alias := by_alias
  exclude_unset := exclude_unset
  exclude_defaults := exclude_defaults
  exclude_none := exclude_none
  set_from := some obj
  set_mode := mode

/-- What a Python `dict` built from a dump's members holds: a repeated key
keeps its first position and its last value. Under `extra='allow'` an extra
may repeat a field's name (when the field is read by its alias), and
`model_dump` (a `dict`) then has one entry where `model_dump_json` writes
both. -/
def pyDict : Json → Json
  | .obj ⟨kvs⟩ => .obj ⟨dedup kvs⟩
  | j => j

/-- `model.model_dump(...)` of a validated model: `exclude_unset` consults
the input it was validated from, and under `extra='allow'` the extras are
dumped after the fields. -/
def model_dump (v : Valid α cfg obj) («include» : Option (List String) := none)
    (exclude : List String := []) (by_alias : Bool := false) (exclude_unset : Bool := false)
    (exclude_defaults : Bool := false) (exclude_none : Bool := false) : Json :=
  let d := toJson (validOpts «include» exclude by_alias exclude_unset exclude_defaults exclude_none obj cfg.mode) v.val
  if m.extra = .allow then pyDict d else d

/-- `model.model_dump_json(indent=None, ...)` of a validated model. -/
def model_dump_json (v : Valid α cfg obj) (indent : Indent := {}) («include» : Option (List String) := none)
    (exclude : List String := []) (by_alias : Bool := false) (exclude_unset : Bool := false)
    (exclude_defaults : Bool := false) (exclude_none : Bool := false) : String :=
  LeanJson.printStr (toJson (validOpts «include» exclude by_alias exclude_unset exclude_defaults exclude_none obj cfg.mode) v.val) { indent := indent.width }

/-- The extra members of the input (`extra='allow'`), as a Python `dict`
holds them. -/
def extraMembers (_ : Valid α cfg obj) : List (String × Json) :=
  match obj with
  | .obj ⟨kvs⟩ => dedup (m.fields.extras cfg.mode kvs)
  | _ => []

/-- `model.model_fields_set`: the fields the input set, by their keys
(aliases where the model gives them), in the model's order, then (under
`extra='allow'`) the extras' keys. A field is set when the input has its key
(or, under `populate_by_name`, its name), or, as in pydantic, when an extra
is named like it. -/
def model_fields_set (_ : Valid α cfg obj) : List String :=
  m.fields.fieldsSet m.extra (some obj) cfg.mode

/-- `model.model_extra`: the members no field read, under `extra='allow'`
(an object, in input order); `none` otherwise, as pydantic gives `None`. -/
def model_extra (v : Valid α cfg obj) : Option Json :=
  if m.extra = .allow then some (.obj ⟨v.extraMembers⟩) else none

/-- `repr(item)` of a validated model: with its input's extras under
`extra='allow'`, at every level. -/
instance : PyRepr (Valid α cfg obj) := ⟨fun _ _ v => PyRepr.reprIn (some obj) cfg.mode v.val⟩
/-- `print(item)` shows `str(item)`. -/
instance : ToString (Valid α cfg obj) := ⟨fun v => Model.strWith (Model.reprArgsIn (some obj) cfg.mode v.val)⟩

/-- **`exclude_unset` dumps only what was set**, with no input to pass: a
validated model's dump writes a field only if its name is in
`model_fields_set`, under its name or, by alias, its key; every other member
is one of its extras' keys, also in `model_fields_set`. -/
theorem exclude_unset_subset [LawfulFields α] (v : Valid α cfg obj) (by_alias : Bool := false)
    («include» : Option (List String) := none) (exclude : List String := [])
    (exclude_defaults exclude_none : Bool := false) :
    ∃ kvs, v.model_dump «include» exclude by_alias (exclude_unset := true)
        exclude_defaults exclude_none = .obj ⟨kvs⟩ ∧
      ∀ p ∈ kvs, p.1 ∈ v.model_fields_set ∨
        ∃ q ∈ m.fields.names.zip m.fields.keys, q.1 ∈ v.model_fields_set ∧ p.1 = q.2 := by
  let o := validOpts «include» exclude by_alias true exclude_defaults exclude_none obj cfg.mode
  have hs : ∀ p ∈ Model.dumpMembers (α := α) o v.val, p.1 ∈ v.model_fields_set ∨
      ∃ q ∈ m.fields.names.zip m.fields.keys, q.1 ∈ v.model_fields_set ∧ p.1 = q.2 := fun p hp => by
    rcases Model.dump_unset_subset (α := α) o v.val rfl p hp with ⟨q, hq, he⟩ | h
    · have hz := (inferInstance : LawfulFields α).lawful.setFields_sub _ _ q hq
      have hn : q.1 ∈ v.model_fields_set := List.mem_append_left _ (List.mem_map_of_mem hq)
      cases hb : by_alias
      · exact Or.inl (by rw [he]; simp only [o, validOpts, hb, Fields.dumpKey]; exact hn)
      · exact Or.inr ⟨q, hz, hn, by rw [he]; simp [o, validOpts, hb, Fields.dumpKey]⟩
    · left
      show p.1 ∈ Fields.fieldsSet _ _ _ _
      simp only [Fields.fieldsSet, List.mem_append, List.mem_filter]
      by_cases hc : p.1 ∈ (m.fields.setFields (some obj) (m.fields.extraKeys m.extra (some obj) cfg.mode)).map Prod.fst
      · exact Or.inl hc
      · exact Or.inr ⟨h, by simpa using hc⟩
  unfold model_dump
  rw [Model.toJson_members]
  split <;> rename_i hx
  · refine ⟨_, rfl, fun p hp => ?_⟩
    rcases Fields.dedup_key _ [] p hp with h | h
    · simp at h
    · obtain ⟨q, hq, he⟩ := List.mem_map.1 h
      rw [← he]; exact hs q (by simpa [pyDict] using hq)
  · exact ⟨_, rfl, fun p hp => hs p (by simpa [pyDict] using hp)⟩

/-- **And every field whose name is in `model_fields_set` is written** by an
`exclude_unset` dump (under its name, or by alias its key). -/
theorem exclude_unset_complete [LawfulFields α] (v : Valid α cfg obj) (by_alias : Bool := false)
    {q : String × String} (hq : q ∈ m.fields.names.zip m.fields.keys) (hs : q.1 ∈ v.model_fields_set) :
    ∃ kvs, v.model_dump (by_alias := by_alias) (exclude_unset := true) = .obj ⟨kvs⟩ ∧
      ∃ k ∈ kvs.map Prod.fst, k = Fields.dumpKey by_alias q := by
  let o := validOpts none [] by_alias true false false obj cfg.mode
  obtain ⟨p, hp, hpe⟩ := Model.dump_unset_complete (α := α) o v.val rfl rfl rfl rfl rfl q
    ((Model.mem_fieldsSet_iff (α := α) _ _ hq).1 hs)
  unfold model_dump
  rw [Model.toJson_members]
  split
  · exact ⟨_, rfl, p.1, Fields.mem_dedup_keys (List.mem_map_of_mem hp), hpe⟩
  · exact ⟨_, rfl, p.1, List.mem_map_of_mem hp, hpe⟩

end Valid

namespace ValidJson

variable {α : Type} [Model α] {strict : Bool} {data : String}

/-- `model.model_dump(...)` of a model validated from JSON text. -/
def model_dump (v : ValidJson α strict data) («include» : Option (List String) := none)
    (exclude : List String := []) (by_alias : Bool := false) (exclude_unset : Bool := false)
    (exclude_defaults : Bool := false) (exclude_none : Bool := false) : Json :=
  v.toValid.model_dump «include» exclude by_alias exclude_unset exclude_defaults exclude_none

/-- `model.model_dump_json(indent=None, ...)` of a model validated from JSON text. -/
def model_dump_json (v : ValidJson α strict data) (indent : Indent := {})
    («include» : Option (List String) := none) (exclude : List String := []) (by_alias : Bool := false)
    (exclude_unset : Bool := false) (exclude_defaults : Bool := false) (exclude_none : Bool := false) : String :=
  v.toValid.model_dump_json indent «include» exclude by_alias exclude_unset exclude_defaults exclude_none

/-- `model.model_fields_set`. -/
def model_fields_set (v : ValidJson α strict data) : List String := v.toValid.model_fields_set

/-- `model.model_extra`. -/
def model_extra (v : ValidJson α strict data) : Option Json := v.toValid.model_extra

instance : PyRepr (ValidJson α strict data) := ⟨fun _ _ v => pyRepr v.toValid⟩
instance : ToString (ValidJson α strict data) := ⟨fun v => toString v.toValid⟩

end ValidJson

/-! ## `TypeAdapter` -/

/-- pydantic's `TypeAdapter(T)`: validation, serialisation and schema for
any supported type, model or not. -/
structure TypeAdapter (α : Type) where
  mk ::

/-- `TypeAdapter(T)`. -/
def TypeAdapter.new (α : Type) : TypeAdapter α := ⟨⟩

namespace TypeAdapter

variable {α : Type} [FromJson α] [ToJson α] [JsonSchema α]

/-- `TypeAdapter.validate_python(obj, strict=None)`. -/
def validate_python (_ : TypeAdapter α) (obj : Json) (strict : Bool := false)
    (from_attributes : Bool := false) :
    Except ValidationError (Valid α { strict, from_attributes } obj) :=
  validateWith α { strict, from_attributes } obj

/-- `TypeAdapter.validate_json(data, strict=None)`. -/
def validate_json (_ : TypeAdapter α) (data : String) (strict : Bool := false) := validateJsonWith α strict data

/-- `TypeAdapter.dump_python(value, ...)`. -/
def dump_python (_ : TypeAdapter α) (a : α) («include» : Option (List String) := none)
    (exclude : List String := []) (by_alias : Bool := false) (exclude_unset : Bool := false)
    (exclude_defaults : Bool := false) (exclude_none : Bool := false) : Json :=
  dumpWith a «include» exclude by_alias exclude_unset exclude_defaults exclude_none

/-- `TypeAdapter.dump_json(value, indent=None, by_alias=False)`. -/
def dump_json (_ : TypeAdapter α) (a : α) (indent : Indent := {}) (by_alias : Bool := false) : String :=
  LeanJson.printStr (toJson { by_alias } a) { indent := indent.width }

/-- `TypeAdapter.json_schema()`. -/
def json_schema (_ : TypeAdapter α) : Json := (JsonSchema.schema α).document

end TypeAdapter

end LeanPydantic
