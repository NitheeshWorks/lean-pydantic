    name := "model_dump options"
    run := do
      let o : Offer := { price := 2.5, item_id := 3 }
      check "{\"price\":2.5,\"discount\":0,\"item_id\":3,\"ok\":true}"
        (LeanJson.printStr (o.model_dump (exclude_none := true)))
