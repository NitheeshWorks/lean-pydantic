import LeanPydantic
import tests.ConformanceTable

/-!
# Conformance cases

Two kinds of case, each naming the upstream test it re-expresses:

* **The pydantic table** (`tests/ConformanceTable.lean`): for each type, input
  mode (`validate_python` on the parsed JSON, or `validate_json` on the
  text), strictness and input, the exact bytes pydantic 2.14.1 produced:
  `dump_json` of the result, or `ValidationError.json()`. The table is
  generated by running pydantic (`scripts/conformance/generate.py`, a
  developer tool); here it is only replayed.
* **Schemas**: `TypeAdapter(T).json_schema()` / `Model.model_json_schema()`
  for the same types, byte for byte.

Run with `lake exe conformance` (`-v` lists every case).
-/

open LeanPydantic

structure Item where
  name : String
  description : Option String := none
  price : Decimal
  tax : Option Decimal := none
  deriving Model

structure Offer where
  price : Decimal ∣ gt 0
  discount : Nat ∣ le 100 := 0
  q : Option (String ∣ maxLength 50 ∧ minLength 3) := none
  item_id : Int
  ok : Bool := true
  deriving Model

structure Image where
  url : String
  name : String
  deriving Model

structure Shop where
  name : String
  tags : List String := []
  image : Option Image := none
  images : List Image
  item_id : Alias "itemId" Int
  sizes : List Int ∣ minLength 1 ∧ maxLength 2
  stock : Dict Int := {}
  deriving Model

/-- Validate `input` as pydantic's `TypeAdapter(T)` would, and print what
pydantic prints. -/
def runAs (α : Type) [FromJson α] [ToJson α] [JsonSchema α] [LawfulJson α] (mode : String)
    (strict : Bool) (input : String) : String :=
  if mode = "json" then
    match validateJsonWith α strict input with
    | .ok a => LeanJson.printStr (toJson {} a.val)
    | .error e => e.json
  else
    match LeanJson.from_json input with
    | .ok j =>
      match validateWith α { strict } j.val with
      | .ok a => LeanJson.printStr (toJson {} a.val)
      | .error e => e.json
    | .error _ => "<input is not JSON>"

/-- A type tag's validator and schema. -/
def dispatch (tag : String) : Option ((String → Bool → String → String) × Json) :=
  let r (α : Type) [FromJson α] [ToJson α] [JsonSchema α] [LawfulJson α] :=
    some (runAs α, (JsonSchema.schema α).document)
  match tag with
  | "int" => r Int
  | "nat" => r Nat
  | "float" => r Decimal
  | "bool" => r Bool
  | "str" => r String
  | "opt_int" => r (Option Int)
  | "opt_str" => r (Option String)
  | "int_gt0_le100" => r (Int ∣ gt 0 ∧ le 100)
  | "int_mult3" => r (Int ∣ multipleOf 3 ∧ ge (-10) ∧ lt 50)
  | "str_3_5" => r (String ∣ minLength 3 ∧ maxLength 5)
  | "str_1_1" => r (String ∣ minLength 1 ∧ maxLength 1)
  | "float_gt0_le2_5_mult0_5" => r (Decimal ∣ gt 0 ∧ le 2.5 ∧ multipleOf 0.5)
  | "nat_le10" => r (Nat ∣ le 10)
  | "item" => r Item
  | "offer" => r Offer
  | "list_int" => r (List Int)
  | "list_str_1_2" => r (List String ∣ minLength 1 ∧ maxLength 2)
  | "dict_int" => r (Dict Int)
  | "opt_list_int" => r (Option (List Int))
  | "list_item" => r (List Item)
  | "image" => r Image
  | "shop" => r Shop
  | _ => none

/-- Validate `input`, then `model_dump_json` it with the given options and
`set_from := input`, as pydantic dumps the instance it validated. -/
def dumpAs (α : Type) [FromJson α] [ToJson α] (input : String) (o : Bool × Bool × Bool × Bool) : String :=
  let (ba, eu, en, ed) := o
  match LeanJson.from_json input with
  | .error _ => "<input is not JSON>"
  | .ok j =>
    match validateWith α {} j.val with
    | .error e => e.json
    | .ok a =>
      let o : DumpOpts :=
        { by_alias := ba, exclude_unset := eu, exclude_none := en, exclude_defaults := ed, set_from := some j.val }
      LeanJson.printStr (toJson o a.val)

def dispatchDump (tag : String) : Option (String → Bool × Bool × Bool × Bool → String) :=
  match tag with
  | "shop" => some (dumpAs Shop)
  | "offer" => some (dumpAs Offer)
  | _ => none

structure Case where
  /-- Upstream test this mirrors, e.g. `tests/test_path.py::test_int`. -/
  upstream : String
  name : String
  run : IO Bool

def check (expected got : String) : IO Bool := do
  unless got == expected do
    IO.println s!"      expected {expected}\n      got      {got}"
  pure (got == expected)

def tableCases : List Case :=
  validationTable.map fun (up, tag, mode, strict, input, expected) =>
    { upstream := up
      name := s!"{tag} {mode}{if strict then " strict" else ""} {input.take 40}"
      run := match dispatch tag with
        | none => pure false
        | some (f, _) => check expected (f mode strict input) }

def schemaCases : List Case :=
  schemaTable.map fun (tag, expected) =>
    { upstream := "pydantic/tests/test_json_schema.py::test_constraints_schema_validation"
      name := s!"schema {tag}"
      run := match dispatch tag with
        | none => pure false
        | some (_, s) => check expected (LeanJson.printStr s) }

/-- Cases written out by hand, for behaviour the table does not reach. -/
def handCases : List Case := [
  { upstream := "pydantic/tests/test_main.py::test_success"
    name := "model_dump options"
    run := do
      let o : Offer := { price := 2.5, item_id := 3 }
      check "{\"price\":2.5,\"discount\":0,\"item_id\":3,\"ok\":true}"
        (LeanJson.printStr (o.model_dump (exclude_none := true)))
      <&&> check "{\"price\":2.5,\"item_id\":3}"
        (LeanJson.printStr (o.model_dump (exclude_defaults := true)))
      <&&> check "{\"item_id\":3}" (LeanJson.printStr (o.model_dump («include» := some ["item_id"])))
      <&&> check "{\"price\":2.5,\"q\":null,\"item_id\":3,\"ok\":true}"
        (LeanJson.printStr (o.model_dump (exclude := ["discount"]))) },
  { upstream := "pydantic/tests/test_main.py::test_success"
    name := "model_dump_json indent"
    run := do
      let i : Item := { name := "Foo", price := 50.5 }
      check "{\n  \"name\": \"Foo\",\n  \"description\": null,\n  \"price\": 50.5,\n  \"tax\": null\n}"
        (i.model_dump_json (indent := some 2)) },
  { upstream := "pydantic/tests/test_main.py::test_ultra_simple_failed"
    name := "errors without url, context, input"
    run := do
      match Offer.model_validate (json% {"price": 0, "item_id": 1}) with
      | .ok _ => pure false
      | .error e =>
        check "[{\"type\":\"greater_than\",\"loc\":[\"price\"],\"msg\":\"Input should be greater than 0\"}]"
          (LeanJson.printStr (.arr (List.toArray <| e.errors (include_url := false) (include_context := false)
            (include_input := false))))
        <&&> pure (e.error_count == 1 && e.title == "Offer") }
]

def dumpCases : List Case :=
  dumpTable.map fun (up, tag, input, o, expected) =>
    { upstream := up
      name := s!"dump {tag} {o} {input.take 40}"
      run := match dispatchDump tag with
        | none => pure false
        | some f => check expected (f input o) }

def cases : List Case := tableCases ++ schemaCases ++ dumpCases ++ handCases

def main (args : List String) : IO UInt32 := do
  let verbose := args.contains "-v"
  let mut failures := 0
  for c in cases do
    let ok ← try c.run catch e => do IO.println s!"      {e}"; pure false
    if verbose || !ok then
      IO.println s!"{if ok then "ok  " else "FAIL"}  {c.name}  [{c.upstream}]"
    unless ok do failures := failures + 1
  IO.println s!"{cases.length} cases, {failures} failing"
  return if failures == 0 then 0 else 1
