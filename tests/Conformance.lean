import LeanPydantic
import tests.ConformanceTable

/-!
# Conformance cases

Two kinds of case, each naming the upstream test it re-expresses:

* **The pydantic table** (`tests/ConformanceTable.lean`): for each type, input
  mode (`validate_python` on the parsed JSON, or `validate_json` on the
  text), strictness and input, the exact bytes pydantic 2.14.1 produced:
  `dump_json` of the result, or `ValidationError.json()`. The table is
  generated by running pydantic (`scripts/conformance/generate.py`, a
  developer tool); here it is only replayed.
* **Schemas**: `TypeAdapter(T).json_schema()` / `Model.model_json_schema()`
  for the same types, byte for byte.

Run with `lake exe conformance` (`-v` lists every case).
-/

open LeanPydantic

structure Item where
  name : String
  description : Option String := none
  price : Decimal
  tax : Option Decimal := none
  deriving Model

structure Offer where
  price : Decimal ∣ gt 0
  discount : Nat ∣ le 100 := 0
  q : Option (String ∣ maxLength 50 ∧ minLength 3) := none
  item_id : Int
  ok : Bool := true
  deriving Model

structure Image where
  url : String
  name : String
  deriving Model

structure Shop where
  name : String
  tags : List String := []
  image : Option Image := none
  images : List Image
  item_id : Alias "itemId" Int
  sizes : List Int ∣ minLength 1 ∧ maxLength 2
  stock : Dict Int := {}
  deriving Model

inductive Color where
  | red
  | green
  deriving Model

structure Im where
  url : String
  deriving Model

structure E2 where
  c : Color
  l : String ∣ oneOf ["a", "b"] := "a"
  one : String ∣ oneOf ["x"]
  u : Int ⊕ String
  t : Int × String
  d : Dict Int
  deriving Model

/-! `model_config`: `extra` and `populate_by_name`, as the generator's
`ExtraForbid`, `ExtraAllow`, `ExtraPop`, `ExtraNested`, `ExtraAliasAllow`, and
FastAPI's `request_form_models` tutorial 002 `FormData`. -/
structure ExtraForbid where
  model_config : ConfigDict (extra := .forbid) := {}
  a : Int
  b : Alias "B" String
  deriving Model

structure ExtraAllow where
  model_config : ConfigDict (extra := .allow) := {}
  a : Int
  b : Alias "B" String := "x"
  deriving Model

structure ExtraPop where
  model_config : ConfigDict (extra := .forbid) (populate_by_name := true) := {}
  a : Int
  b : Alias "B" String
  deriving Model

/-! The field laws hold for every derived model, aliases with `forbid` and
`populate_by_name` included, so the `forbid` law, the located errors and the
round trip apply to them; only schema soundness is withheld (UP-065). -/
example : LawfulFields ExtraForbid := inferInstance
example : LawfulFields ExtraPop := inferInstance
example (cfg : Cfg) (kvs : List (String × Json)) (a : ExtraForbid) :=
  Model.validate_forbid_iff (α := ExtraForbid) rfl cfg kvs a
example (cfg : Cfg) (kvs : List (String × Json)) (a : ExtraForbid) :=
  Model.validate_forbid_keys_iff (α := ExtraForbid) rfl rfl cfg kvs a
example (cfg : Cfg) (kvs : List (String × Json)) (a : ExtraPop) :=
  Model.validate_forbid_iff (α := ExtraPop) rfl cfg kvs a
example (a : ExtraPop) := Model.model_validate_model_dump a
example (cfg : Cfg) (kvs : List (String × Json)) (es) (h : fromJson (α := ExtraPop) cfg (.obj ⟨kvs⟩) = .error es) :=
  Model.validate_loc_prefix cfg kvs es h

structure ExtraNested where
  model_config : ConfigDict (extra := .forbid) := {}
  inner : ExtraAllow
  f : Option ExtraForbid := none
  deriving Model

structure ExtraAliasAllow where
  model_config : ConfigDict (extra := .allow) := {}
  a : Alias "alias_a" String := "default"
  b : Alias "alias_b" String := "default"
  deriving Model

structure FormData where
  username : String
  password : String
  model_config : ConfigDict (extra := .forbid) := {}
  deriving Model

/-! Validators and serializers: pydantic's model
```
class M(BaseModel):
    a: Annotated[int, AfterValidator(even)]
    b: Annotated[int, BeforeValidator(strip)] = 0
    c: Annotated[int, WrapValidator(wrap)] = 0
    d: Annotated[int, PlainSerializer(lambda v: f'#{v}', return_type=str)] = 1
    e: Annotated[list[int], WrapSerializer(lambda v, h: h(v)[:1])] = []
```
-/
namespace Functional
def even (v : Int) : Except String Int := if v % 2 != 0 then .error "must be even" else .ok v
def strip : Json → Except String Json
  | .str s => .ok (.str s.trimAscii.toString)
  | j => .ok j
def wrap (handler : Handler Int) : Json → Except Raise Int
  | .str "none" => .ok 0
  | j => match handler j with
    | .ok v => .ok v
    | .error _ => .error (.value "bad number")
structure M where
  a : After Int even
  b : Before Int strip := 0
  c : Wrap Int wrap := 0
  d : Serialize Int (fun v => .str s!"#{v}") := 1
  e : WrapSerialize (List Int) (fun h v => match h v with | .arr xs => .arr (xs.extract 0 1) | j => j) := {}
  deriving Model
/-- `x: list[int] = Field(default_factory=list)`, `y: int = Field(default_factory=lambda: 3)` -/
structure F where
  x : Factory (List Int) := []
  y : Factory Int := 3
  deriving Model
end Functional

/-! Regression (lean-fastapi report): models derived inside a namespace get
their methods in that namespace, not under it twice. -/
namespace Shop.Api
inductive Level where
  | low | high
  deriving Model
structure Tag where
  name : String
  level : Level := .low
  deriving Model
end Shop.Api

/-- Validate `input` as pydantic's `TypeAdapter(T)` would, and print what
pydantic prints. -/
def runAs (α : Type) [FromJson α] [ToJson α] [JsonSchema α] (mode : String)
    (strict : Bool) (input : String) : String :=
  if mode = "json" then
    match validateJsonWith α strict input with
    | .ok a => LeanJson.printStr (toJson { set_from := some a.input, set_mode := .json } a.val)
    | .error e => e.json
  else
    match LeanJson.from_json input with
    | .ok j =>
      match validateWith α { strict, from_attributes := mode = "python-attrs" } j.val with
      | .ok a => LeanJson.printStr (toJson { set_from := some j.val } a.val)
      | .error e => e.json
    | .error _ => "<input is not JSON>"

/-- What `print` shows for a validated value: `repr(v)`, and `str(v)` for a
model (with its extras under `extra='allow'`). -/
class ShowValid (α : Type) [FromJson α] where
  display : {cfg : Cfg} → {obj : Json} → String → Valid α cfg obj → String

instance (priority := low) {α : Type} [FromJson α] [PyRepr α] : ShowValid α := ⟨fun _ v => pyRepr v.val⟩
instance {α : Type} [Model α] : ShowValid α :=
  ⟨fun out v => if out = "str" then toString v else pyRepr v⟩

/-- Validate `input`, then `repr` (or `str`) the result, or `str(e)`. -/
def reprAs (α : Type) [FromJson α] [ShowValid α] (mode : String) (strict : Bool) (out input : String) : String :=
  if mode = "json" then
    match validateJsonWith α strict input with
    | .ok a => ShowValid.display out a.toValid
    | .error e => toString e
  else
    match LeanJson.from_json input with
    | .ok j =>
      match validateWith α { strict } j.val with
      | .ok a => ShowValid.display out a
      | .error e => toString e
    | .error _ => "<input is not JSON>"

/-- A type tag's validator, schema, and `print` output. -/
def dispatch (tag : String) :
    Option ((String → Bool → String → String) × Json × (String → Bool → String → String → String)) :=
  let r (α : Type) [FromJson α] [ToJson α] [JsonSchema α] [ShowValid α] :=
    some (runAs α, (JsonSchema.schema α).document, reprAs α)
  match tag with
  | "int" => r Int
  | "nat" => r Nat
  | "float" => r Decimal
  | "bool" => r Bool
  | "str" => r String
  | "opt_int" => r (Option Int)
  | "opt_str" => r (Option String)
  | "int_gt0_le100" => r (Int ∣ gt 0 ∧ le 100)
  | "int_mult3" => r (Int ∣ multipleOf 3 ∧ ge (-10) ∧ lt 50)
  | "str_3_5" => r (String ∣ minLength 3 ∧ maxLength 5)
  | "str_1_1" => r (String ∣ minLength 1 ∧ maxLength 1)
  | "float_gt0_le2_5_mult0_5" => r (Decimal ∣ gt 0 ∧ le 2.5 ∧ multipleOf 0.5)
  | "nat_le10" => r (Nat ∣ le 10)
  | "item" => r Item
  | "offer" => r Offer
  | "list_int" => r (List Int)
  | "list_str_1_2" => r (List String ∣ minLength 1 ∧ maxLength 2)
  | "dict_int" => r (Dict Int)
  | "opt_list_int" => r (Option (List Int))
  | "list_item" => r (List Item)
  | "image" => r Image
  | "shop" => r Shop
  | "color" => r Color
  | "e2" => r E2
  | "literal_ab" => r (String ∣ oneOf ["a", "b"])
  | "literal_quote" => r (String ∣ oneOf ["b'c", "d\"e", "x"])
  | "literal_int" => r (Int ∣ oneOf [1, 2])
  | "union_int_str" => r (Int ⊕ String)
  | "union_str_int" => r (String ⊕ Int)
  | "union_float_int" => r (Decimal ⊕ Int)
  | "union_int_float" => r (Int ⊕ Decimal)
  | "union_mixed" => r ((Int ∣ gt 0) ⊕ List Int ⊕ Im ⊕ String)
  | "opt_union" => r (Option (Int ⊕ String))
  | "tuple_isb" => r (Int × String × Bool)
  | "tuple_is" => r (Int × String)
  | "decimal" => r PyDecimal
  | "set_int" => r (PySet Int)
  | "set_int_min2" => r (PySet Int ∣ minLength 2 ∧ maxLength 3)
  | "plain_float" => r Float
  | "float_gt0" => r (Float ∣ gt 0)
  | "condecimal_5_2" => r (Condecimal (some 5) (some 2))
  | "condecimal_gt0_3" => r (Condecimal (some 3) none ∣ gt 0)
  | "condecimal_places1_mult" => r (Condecimal none (some 1) ∣ multipleOf 0.5 ∧ le 10)
  | "extra_forbid" => r ExtraForbid
  | "extra_allow" => r ExtraAllow
  | "extra_pop" => r ExtraPop
  | "extra_nested" => r ExtraNested
  | "extra_alias_allow" => r ExtraAliasAllow
  | "form_data" => r FormData
  | _ => none

/-- Validate `input`, then `model_dump_json` it with the given options and
`set_from := input`, as pydantic dumps the instance it validated. -/
def dumpAs (α : Type) [FromJson α] [ToJson α] (input : String) (o : Bool × Bool × Bool × Bool) : String :=
  let (ba, eu, en, ed) := o
  match LeanJson.from_json input with
  | .error _ => "<input is not JSON>"
  | .ok j =>
    match validateWith α {} j.val with
    | .error e => e.json
    | .ok a =>
      let o : DumpOpts :=
        { by_alias := ba, exclude_unset := eu, exclude_none := en, exclude_defaults := ed, set_from := some j.val }
      LeanJson.printStr (toJson o a.val)

def dispatchDump (tag : String) : Option (String → Bool × Bool × Bool × Bool → String) :=
  match tag with
  | "shop" => some (dumpAs Shop)
  | "offer" => some (dumpAs Offer)
  | "extra_allow" => some (dumpAs ExtraAllow)
  | "extra_nested" => some (dumpAs ExtraNested)
  | "extra_alias_allow" => some (dumpAs ExtraAliasAllow)
  | _ => none

structure Case where
  /-- Upstream test this mirrors, e.g. `tests/test_path.py::test_int`. -/
  upstream : String
  name : String
  run : IO Bool

def check (expected got : String) : IO Bool := do
  unless got == expected do
    IO.println s!"      expected {expected}\n      got      {got}"
  pure (got == expected)

def tableCases : List Case :=
  validationTable.map fun (up, tag, mode, strict, input, expected) =>
    { upstream := up
      name := s!"{tag} {mode}{if strict then " strict" else ""} {input.take 40}"
      run := match dispatch tag with
        | none => pure false
        | some (f, _, _) => check expected (f mode strict input) }

def schemaCases : List Case :=
  schemaTable.map fun (tag, expected) =>
    { upstream := "pydantic/tests/test_json_schema.py::test_constraints_schema_validation"
      name := s!"schema {tag}"
      run := match dispatch tag with
        | none => pure false
        | some (_, s, _) => check expected (LeanJson.printStr s) }

/-- `M.model_validate_json(input)`, then `model_dump_json()` or the errors,
as pydantic printed them. -/
def functionalTable : List (String × String) := [
    ("{\"a\":3}", "[{\"type\":\"value_error\",\"loc\":[\"a\"],\"msg\":\"Value error, must be even\",\"input\":3,\"ctx\":{\"error\":\"must be even\"},\"url\":\"https://errors.pydantic.dev/2.14/v/value_error\"}]"),
    ("{\"a\":\"x\"}", "[{\"type\":\"int_parsing\",\"loc\":[\"a\"],\"msg\":\"Input should be a valid integer, unable to parse string as an integer\",\"input\":\"x\",\"url\":\"https://errors.pydantic.dev/2.14/v/int_parsing\"}]"),
    ("{\"a\":2,\"b\":\" 7 \"}", "{\"a\":2,\"b\":7,\"c\":0,\"d\":\"#1\",\"e\":[]}"),
    ("{\"a\":2,\"b\":\" x \"}", "[{\"type\":\"int_parsing\",\"loc\":[\"b\"],\"msg\":\"Input should be a valid integer, unable to parse string as an integer\",\"input\":\"x\",\"url\":\"https://errors.pydantic.dev/2.14/v/int_parsing\"}]"),
    ("{\"a\":2,\"c\":\"none\"}", "{\"a\":2,\"b\":0,\"c\":0,\"d\":\"#1\",\"e\":[]}"),
    ("{\"a\":2,\"c\":\"q\"}", "[{\"type\":\"value_error\",\"loc\":[\"c\"],\"msg\":\"Value error, bad number\",\"input\":\"q\",\"ctx\":{\"error\":\"bad number\"},\"url\":\"https://errors.pydantic.dev/2.14/v/value_error\"}]"),
    ("{\"a\":2,\"c\":5,\"d\":4,\"e\":[1,2]}", "{\"a\":2,\"b\":0,\"c\":5,\"d\":\"#4\",\"e\":[1]}")]

def functionalCases : List Case :=
  functionalTable.map fun (input, expected) =>
    { upstream := "pydantic/tests/test_validators.py::test_annotated_validator_after"
      name := s!"validators and serializers {input}"
      run := check expected (match Functional.M.model_validate_json input with
        | .ok m => m.val.model_dump_json
        | .error e => e.json) }

/-- `model_extra`, `model_fields_set` and `model_dump()` of a validated
`extra='allow'` model, as text. -/
def extraReport {cfg obj} (v : Valid ExtraAllow cfg obj) : String :=
  s!"{(v.model_extra.map LeanJson.printStr)} {v.model_fields_set} {LeanJson.printStr v.model_dump}"

/-- Cases written out by hand, for behaviour the table does not reach. -/
def handCases : List Case := [
  { upstream := "pydantic-core/tests/test_misc.py::test_unicode_error_input_repr"
    name := "str(ValidationError) cuts a long input's repr at a character boundary"
    run := check "1 validation error for int\n  Input should be a valid integer, unable to parse string as an integer [type=int_parsing, input_value='ÿÿÿÿÿÿÿÿÿÿÿÿ...ÿÿÿÿÿÿÿÿÿÿÿ', input_type=str]"
      (match (TypeAdapter.new Int).validate_python (.str (String.ofList (List.replicate 1000 'ÿ'))) with
        | .ok _ => "ok"
        | .error e => e.str (include_url := false)) },
  { upstream := "pydantic/tests/test_main.py::test_allow_extra_repr"
    name := "repr and str of a model with extras, nested"
    run := match ExtraNested.model_validate (json% {"inner": {"a": 1, "q": 2}}) with
      | .ok v => check "ExtraNested(inner=ExtraAllow(a=1, b='x', q=2), f=None) inner=ExtraAllow(a=1, b='x', q=2) f=None"
          (pyRepr v ++ " " ++ toString v)
      | .error e => check "ok" e.str },
  { upstream := "pydantic/tests/test_main.py::test_allow_extra"
    name := "extra='allow': model_extra, model_fields_set and model_dump (a dict) by input mode"
    run := do
      -- pydantic: Python input {'z': 1, 'b': 'q'}, {'a', 'z', 'b'}, {'a': 1, 'b': 'q', 'z': 1};
      -- JSON text drops the field name 'b': {'z': 1}, {'a', 'z'}, {'a': 1, 'b': 'x', 'z': 1}
      let py := match ExtraAllow.model_validate (json% {"z": 1, "a": 1, "b": "q"}) with
        | .ok v => extraReport v
        | .error e => e.json
      let js := match ExtraAllow.model_validate_json "{\"z\": 1, \"a\": 1, \"b\": \"q\"}" with
        | .ok v => extraReport v.toValid
        | .error e => e.json
      check "(some {\"z\":1,\"b\":\"q\"}) [a, B, z, b] {\"a\":1,\"b\":\"q\",\"z\":1}" py
      <&&> check "(some {\"z\":1}) [a, z] {\"a\":1,\"b\":\"x\",\"z\":1}" js },
  { upstream := "pydantic/tests/test_main.py::test_model_extra_is_none_when_extra_is_forbid"
    name := "extra='forbid' and 'ignore': model_extra is None"
    run := do
      let f := match ExtraForbid.model_validate (json% {"a": 1, "B": "q"}) with
        | .ok v => toString (v.model_extra.map LeanJson.printStr)
        | .error e => e.json
