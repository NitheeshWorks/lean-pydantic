    name := "validated models remember the fields set"
    run := do
      match Offer.model_validate (json% {"price": 2.5, "item_id": 3}),
          Offer.model_validate_json "{\"price\": 2.5, \"q\": null, \"item_id\": 3}" with
      | .ok o, .ok p =>
        check "{\"price\":2.5,\"item_id\":3}" (LeanJson.printStr (o.model_dump (exclude_unset := true)))
        <&&> check "{\"price\":2.5,\"discount\":0,\"q\":null,\"item_id\":3,\"ok\":true}"
          (LeanJson.printStr o.model_dump)
        <&&> check "[price, item_id]" (toString o.model_fields_set)
        <&&> check "{\"price\":2.5,\"q\":null,\"item_id\":3}" (p.model_dump_json (exclude_unset := true))
        <&&> check "[price, q, item_id]" (toString p.model_fields_set)
      | _, _ => pure false },
  { upstream := "pydantic-core/tests/validators/test_decimal.py::test_decimal_multiple_of"
    name := "UP-055 deviation: Decimal multiple_of is exact past 28 digits"
    run := do
      -- Python divides at 28 digits and reports multiple_of on all three
      -- (pydantic#13970); each value here is a multiple of 0.5, so the first
      -- failing check is le 10
      let ta := TypeAdapter.new (Condecimal none (some 1) ∣ multipleOf 0.5 ∧ le 10)
      let types := ["123456789012345678901234567890e5", "1e300", "\"1e999999999\""].map fun s =>
        match ta.validate_json s with
        | .ok _ => "ok"
        | .error e => String.intercalate "," (e.errors.map fun (j : LeanJson.Json) =>
            match j.getObjVal? "type" with
            | some (.str t) => t
            | _ => "?")
      check "[less_than_equal, less_than_equal, less_than_equal]" (toString types) },
  { upstream := "pydantic/tests/test_types.py::test_pattern"
    name := "regex size-limit deviation: the bound is maxLeaves classes, not Rust's compiled size"
    run := do
      -- Rust's regex refuses a compiled program over 10 MiB (SchemaError
      -- "Compiled regex exceeds size limit"), measured on its own program,
      -- where Unicode \w is large and a literal is small. Here the bound is
      -- Parse.maxLeaves: 10000 classes once repetitions are expanded. So
      -- (\w{1,30}\s?){1,20}x (620 classes; pydantic: SchemaError) compiles
      -- and runs, and a{10001} (pydantic: accepted) is refused.
      let big := "(\\w{1,30}\\s?){1,20}x"
      let answers := match Regex.compile big with
        | .ok r => [r.search "hello world x", r.search "hello world",
            r.search (String.join (List.replicate 25 "word ")), r.search "x"]
        | .error _ => []
      let refused := match Regex.compile "a{10001}" with
        | .ok _ => "compiled"
        | .error _ => "error"
      check "[true, false, false, false]" (toString answers)
      <&&> check "error" refused
      <&&> check "10000" (toString Regex.maxLeaves) },
  { upstream := "pydantic-core/tests/validators/test_float.py::test_float"
    name := "float from long strings: halfway ties, a tie broken past 1000 digits, 1 MiB"
    run := do
      -- values from pydantic 2.14.1's TypeAdapter(float).validate_python, as bits
      let ta := TypeAdapter.new Float
      let mid := "1.00000000000000011102230246251565404236316680908203125"
      let bits (s : String) : String := match ta.validate_python (.str s) with
        | .ok x => toString x.val.toBits
        | .error _ => "error"
      check "4607182418800017408" (bits mid)
      <&&> check "4607182418800017409" (bits (mid ++ String.ofList (List.replicate 1000 '0') ++ "1"))
      <&&> check "4607182418800017408" (bits ((mid.dropEnd 1).toString ++ "4" ++ String.ofList (List.replicate 1000 '9')))
      <&&> check "9218868437227405312" (bits (String.ofList (List.replicate 1048576 '7')))
      <&&> check "117281590732642743"
        (bits ("0." ++ String.ofList (List.replicate 300 '0') ++ String.ofList (List.replicate 1048576 '7'))) },
  { upstream := "pydantic-core/tests/validators/test_float.py::test_float"
    name := "float: a 768-digit halfway tie, padded, broken past 2000 zeros, and just below"
    run := do
      -- the midpoint between the doubles (2^53 - 2) * 2^-1074 and the next one
      -- up, exactly (768 significant digits, the most a midpoint has), from
      -- CPython's Decimal; expected bits from pydantic 2.14.1 and float()
      let ta := TypeAdapter.new Float
      let mid := "0."
      let zeros := String.ofList (List.replicate 2000 '0')
      let lastDown := match mid.toList.getLast? with
        | some c => (mid.dropEnd 1).toString ++ String.singleton (Char.ofNat (c.toNat - 1))
        | none => mid
      let bits (s : String) : String := match ta.validate_python (.str s) with
        | .ok x => toString x.val.toBits
        | .error _ => "error"
      check "9007199254740990" (bits mid)
      <&&> check "9007199254740990" (bits (mid ++ zeros))
      <&&> check "9007199254740991" (bits (mid ++ zeros ++ "1"))
      <&&> check "9007199254740990" (bits (lastDown ++ String.ofList (List.replicate 2000 '9'))) },
  { upstream := "pydantic/tests/test_main.py::test_ultra_simple_failed"
    name := "errors without url, context, input"
    run := do
      match Offer.model_validate (json% {"price": 0, "item_id": 1}) with
      | .ok _ => pure false
      | .error e =>
        check "[{\"type\":\"greater_than\",\"loc\":[\"price\"],\"msg\":\"Input should be greater than 0\"}]"
          (LeanJson.printStr (.arr (List.toArray <| e.errors (include_url := false) (include_context := false)
            (include_input := false))))
        <&&> pure (e.error_count == 1 && e.title == "Offer") }
]

def reprCases : List Case :=
  reprTable.map fun (up, tag, mode, strict, out, input, expected) =>
    { upstream := up
      name := s!"{out} {tag} {mode}{if strict then " strict" else ""} {input.take 40}"
      run := match dispatch tag with
        | none => pure false
        | some (_, _, g) => check expected (g mode strict out input) }

def dumpCases : List Case :=
  dumpTable.map fun (up, tag, input, o, expected) =>
    { upstream := up
      name := s!"dump {tag} {o} {input.take 40}"
      run := match dispatchDump tag with
        | none => pure false
        | some f => check expected (f input o) }

/-- Patterns lean-pydantic rejects though Rust's `regex` accepts them
(documented in docs/traceability.toml, `regex.unsupported-syntax`): Unicode
property classes, `^` and `$` under `(?m)`, the word assertions under `(?-u)`,
and `\b{start-half}` and `\b{end-half}`. -/
def unsupportedPatterns : List String :=
  ["\\p{L}", "^\\p{L}$", "(?m)^b", "(?m)a$", "(?mR)^b", "(?-u)\\b", "(?-u)\\B", "(?-u)\\<a",
   "\\b{start-half}a", "\\b{end-half}"]

def regexCases : List Case :=
  regexTable.map fun (pat, input, expected) =>
    { upstream := "pydantic/tests/test_types.py::test_pattern"
      name := s!"pattern {pat} on {input.take 20}"
      run :=
        let got := match Regex.compile pat with
          | .ok r => toString (r.search input)
          | .error _ => "error"
        if pat ∈ unsupportedPatterns then check "error" got else check expected got }

def cases : List Case := tableCases ++ schemaCases ++ reprCases ++ dumpCases ++ handCases ++ regexCases ++ functionalCases

def main (args : List String) : IO UInt32 := do
  let verbose := args.contains "-v"
  let mut failures := 0
  for c in cases do
    let ok ← try c.run catch e => do IO.println s!"      {e}"; pure false
    if verbose || !ok then
      IO.println s!"{if ok then "ok  " else "FAIL"}  {c.name}  [{c.upstream}]"
    unless ok do failures := failures + 1
  IO.println s!"{cases.length} cases, {failures} failing"
  return if failures == 0 then 0 else 1
