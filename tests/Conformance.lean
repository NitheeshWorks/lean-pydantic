      let pats := ["^(a+)+$", "(a|aa)*b", "^(\\w+\\s?)*$", "(a*)*$b", "^(a|a?)+$"]
      let t0 ← IO.monoMsNow
      let ok := pats.all fun p => match Regex.compile p with
        | .ok r => !(match Regex.Regex.Nfa.build r with | some N => N.search text | none => r.search text)
